# OSDuo DashHub Environment Configuration
# Copy this file to .env and customize as needed

# Application Settings
# NODE_ENV is set by docker-compose (environment: NODE_ENV=...).
# Do NOT set NODE_ENV here — Vite rejects NODE_ENV=production in .env files.
API_PORT=48231
TZ=UTC

# Port Mapping
HOST_PORT=48215
# CONTAINER_PORT=80  # Usually don't change this

# Optional: Custom data directory (for host mounting)
# DATA_DIR=./data
# CONFIG_DIR=./config

# Config directory inside container (should match volume mount)
CONFIG_DIR=/app/data

# Optional: GitHub Personal Access Token for higher API rate limits (5000/hr vs 60/hr)
# Generate at: https://github.com/settings/tokens
# Required scope: none (public repos only need no scope)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
